<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <!-- Targeted changes commute with Compatibility/Grains RawRice replacement. -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ScenarioDef[defName="AMJC_NewVillage"]/scenario/parts/li[@Class="ScenPart_PlayerPawnsArriveMethod"]</xpath>
    <value>
      <li Class="ScenPart_PlayerPawnsArriveMethod">
                <def>PlayerPawnsArriveMethod</def>
                <method>Standing</method>
              </li>
      <li Class="ScenPart_StartingResearch">
                <def>StartingResearch</def>
                <project>DankPyon_Lumber</project>
              </li>
      <li Class="ScenPart_StartingResearch">
                <def>StartingResearch</def>
                <project>DankPyon_RusticFurniture</project>
              </li>
      <li Class="ScenPart_StartingResearch">
                <def>StartingResearch</def>
                <project>DankPyon_BasicCooking</project>
              </li>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ScenarioDef[defName="AMJC_NewVillage"]/scenario/parts/li[thingDef="Pemmican"]</xpath>
    <value>
      <li Class="ScenPart_StartingThing_Defined">
                <def>StartingThing_Defined</def>
                <thingDef>DankPyon_MealRations</thingDef>
                <count>60</count>
              </li>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ScenarioDef[defName="AMJC_NewVillage"]/scenario/parts/li[thingDef="WoodLog"]</xpath>
    <value>
      <li Class="ScenPart_StartingThing_Defined">
                <def>StartingThing_Defined</def>
                <thingDef>WoodLog</thingDef>
                <count>200</count>
              </li>
      <li Class="ScenPart_StartingThing_Defined">
                <def>StartingThing_Defined</def>
                <thingDef>DankPyon_RawWood</thingDef>
                <count>200</count>
              </li>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ScenarioDef[defName="AMJC_NewVillage"]/scenario/parts/li[thingDef="Steel"]</xpath>
    <value>
      <li Class="ScenPart_StartingThing_Defined">
                <def>StartingThing_Defined</def>
                <thingDef>DankPyon_IronIngot</thingDef>
                <count>30</count>
              </li>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ScenarioDef[defName="AMJC_NewVillage"]/scenario/parts/li[thingDef="MeleeWeapon_Knife"]</xpath>
    <value>
      <li Class="ScenPart_StartingThing_Defined">
                <def>StartingThing_Defined</def>
                <thingDef>MeleeWeapon_Knife</thingDef>
                <count>2</count>
                <stuff>DankPyon_IronIngot</stuff>
              </li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/PawnKindDef[defName="AMJC_Villager"]/apparelTags</xpath>
    <value>
      <li>DankPyon_Peasant</li>
    </value>
  </Operation>
</Patch>
